<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filmingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101218"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Filming Assistant"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Check your phone movement before filming."
            android:textColor="#C4B5FD"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvFilmingTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Your reel"
            android:textColor="#C5C7D0"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="#20232C"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PHONE MOVEMENT"
                android:textColor="#C4B5FD"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMovementStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Waiting for sensor"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressMovement"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressTint="#C4B5FD"
                android:progressBackgroundTint="#444856"
                android:contentDescription="Estimated phone movement level" />

            <TextView
                android:id="@+id/tvMovementValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Estimated movement: -- m/s²"
                android:textColor="#C5C7D0"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvFilmingAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Place your phone in your intended filming position."
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Sensor readings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSensorDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Accelerometer: checking availability..."
            android:textColor="#C5C7D0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRawReadings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="X: --    Y: --    Z: -- m/s²"
            android:textColor="#C5C7D0"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="How to use"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="5dp"
            android:text="1. Position your phone for your planned shot.\n2. Wait for the movement indicator to settle.\n3. Adjust your grip or support if movement is detected.\n4. Return to your plan when you are ready."
            android:textColor="#C5C7D0"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnBackToPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:backgroundTint="#C4B5FD"
            android:text="Back to Reel Plan"
            android:textAllCaps="false"
            android:textColor="#161222"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="A simple movement aid, not video stabilisation. Low movement does not guarantee a sharp or well-framed recording."
            android:textColor="#C5C7D0"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>